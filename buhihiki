Vector2.new(VPC.X,Cam.ViewportSize.Y)d.T.To=Vector2.new(sp.X,sp.Y)d.T.Visible=true if wallMode=="Color Code"then d.T.Color=lineColor end elseif d.T.Visible then d.T.Visible=false end elseif d.T.Visible then d.T.Visible=false end if d.H.Enabled~=S.Chams then d.H.Enabled=S.Chams end if updateDist then local m=floor((d.R.Position-Cam.CFrame.Position).Magnitude)if m~=d.lD then d.lD=m d.DL.Text=m.."m"end end else ClearPlayer(name)end end if S.Aim or S.Trig or S.Silent then local target=GetTarget()Target=target if target then local tp=PredictPos(target)if S.Aim then Cam.CFrame=SmoothCFrame(Cam.CFrame,CFrame.new(Cam.CFrame.Position,tp),S.Smooth)end if S.Silent and S.SilentMode=="Mouse"then LockCamera()end if S.Trig and now-LastShot>S.TrigD then LastShot=now TriggerShot(target)end end end if S.AutoShoot and not IsLobby()and Target then if now-LastAuto>S.AutoShootDelay then LastAuto=now if S.Silent and S.SilentMode=="Hook"then SilentTarget=Target FireTool()task.delay(0.08,function()SilentTarget=nil end)else FireTool()end end end if S.Fly and FlyBV then local dir=Vector3.zero if FlyMode=="up"then dir=Cam.CFrame.LookVector elseif FlyMode=="down"then dir=-Cam.CFrame.LookVector end if dir.Magnitude>0 then FlyBV.Velocity=dir*S.FlyV else FlyBV.Velocity=Vector3.zero end end end)
